# ── Google Earth Engine ───────────────────────────────────────────────────────
GEE_PROJECT_ID=your-gee-project-id
# Path to a service-account JSON key file (leave blank to use user auth)
GEE_SERVICE_ACCOUNT_KEY=

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=hf_...

# ── Model selection ───────────────────────────────────────────────────────────
# Backbone: "ibm-nasa-geospatial/Prithvi-100M"
PRITHVI_MODEL_ID=ibm-nasa-geospatial/Prithvi-100M
# LLM council: "google/gemma-2b-it" | "google/gemma-7b-it"
COUNCIL_MODEL_ID=google/gemma-2b-it

# ── Compliance thresholds ─────────────────────────────────────────────────────
EUDR_CUTOFF_DATE=2020-12-31
DIRECT_LOSS_THRESHOLD=5.0
BUFFER_LOSS_THRESHOLD=20.0
BUFFER_RADIUS_KM=5.0

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Output ────────────────────────────────────────────────────────────────────
REPORT_OUTPUT_DIR=./reports
